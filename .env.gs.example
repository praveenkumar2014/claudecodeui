# Copy to .env.gs and configure through a secret manager in production.
NODE_ENV=production
# Verify CloudCLI server port and URL path before setting reverse proxy.
PORT=replace-after-runtime-audit
GS_PUBLIC_URL=https://your-domain.example
# Must be an internal service URL and match the verified NanoBot interface.
NANOBOT_BASE_URL=http://gs-agent-brain:replace-after-runtime-audit
NANOBOT_API_TOKEN=replace-with-long-random-secret
DATABASE_URL=replace-with-audited-database-connection
SESSION_SECRET=replace-with-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-key
